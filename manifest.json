{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Deskly",
  "version": "1.8.2",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "minimum_chrome_version": "114",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png"
    }
  },
  "background": { "service_worker": "src/background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "omnibox": { "keyword": "dk" },
  "permissions": ["storage", "tabs", "tabGroups", "sidePanel", "contextMenus", "favicon", "history", "topSites", "search"],
  "host_permissions": ["https://suggestqueries.google.com/*", "https://t3.gstatic.com/*", "https://api.github.com/*"],
  "optional_permissions": ["bookmarks"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "commands": {
    "open-panel": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "__MSG_cmdPanel__"
    },
    "new-link": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "__MSG_cmdNewLink__"
    }
  }
}
